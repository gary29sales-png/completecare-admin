# Runtime
NODE_ENV=production
PORT=3000
TRUST_PROXY=true

# Supabase is required in production. Apply the SQL migration first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret

# Admin login/session. Generate a long random ADMIN_SESSION_SECRET.
ADMIN_PASSWORD=replace-with-secret
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_ORIGIN=https://completecare-admin.internal.example

# Exact origin(s) of the separately deployed guide, comma separated.
# Leave empty to disable browser cross-origin access.
PUBLIC_ALLOWED_ORIGINS=https://completecare-guide.example

# Optional bounded limits.
MAX_UPLOAD_BYTES=10485760
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
